# ==============================================================================
# AIVES BACKEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy file này thành .env trong thư mục back-end/ để sử dụng
# File .env đã được cấu hình trong .gitignore, tuyệt đối không commit lên git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH SERVER & PROFILE
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH DATABASE (PostgreSQL 16)
# Thay đổi URL, username, password tương ứng với máy local hoặc cloud (Neon/Supabase)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aives_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH BẢO MẬT JWT
# Khóa bí mật dùng để mã hóa và giải mã JWT token (tối thiểu 256 bits)
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH GỬI EMAIL (SMTP GMAIL)
# Để gửi link kích hoạt tài khoản / đặt mật khẩu cho sinh viên & giảng viên
# Cách lấy mật khẩu ứng dụng Gmail (App Password):
#   Google Account -> Security -> 2-Step Verification -> App passwords -> Tạo mới
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=no-reply@aives.local
FRONTEND_BASE_URL=http://localhost:5173

# Đặt MAIL_LOG_LINKS=true khi chạy local mà chưa có cấu hình SMTP
# Link kích hoạt / đổi mật khẩu sẽ được in trực tiếp ra log console của Spring Boot
MAIL_LOG_LINKS=true

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH CORS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
